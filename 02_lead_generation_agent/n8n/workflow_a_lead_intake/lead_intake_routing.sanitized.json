      },
      "name": "Lead Intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "template-lead-intake",
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body;\nif (!body || typeof body !== 'object' || Array.isArray(body)) throw new Error('Expected a JSON lead object.');\n// Keep unknown keys so FastAPI can reject them; never forward webhook headers.\nconst normalized = Object.fromEntries(Object.entries(body).map(([k,v]) => [k, typeof v === 'string' ? v.trim() : v]));\nreturn [{json: normalized}];"
      },
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "id": "template-normalize-input",
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/leads?use_ai=true",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json",
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "name": "Capture Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "id": "template-capture-lead",
      "onError": "stopWorkflow",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data = $input.first().json;\nconst lead = data.lead;\nif (typeof data.created !== 'boolean' || !lead || typeof lead.id !== 'string') throw new Error('Invalid capture response.');\nconst route = lead.final_qualification ?? lead.qualification;\nif (!['hot','warm','cold'].includes(route)) throw new Error('Unsupported qualification.');\nreturn [{json:{lead,created:data.created,route}}];"
      },
      "name": "Classify Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "id": "template-classify-lead",
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "options": {
          "returnFirstMatch": false
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "lead_id",
              "lookupValue": "={{ $('Classify Lead').first().json.lead.id }}"
            }
          ]
        }
      },
      "name": "Find CRM Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "position": [
        1040,
        0
      ],
      "id": "template-find-crm-lead",
      "onError": "stopWorkflow",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Classify Lead').first().json;\nconst rows = $input.all().map(i=>i.json).filter(r=>r.lead_id !== undefined && String(r.lead_id).trim() !== '');\nif (rows.length > 1 || rows.some(r=>r.lead_id !== ctx.lead.id)) throw new Error('CRM identity conflict.');\nif (rows.length) return [{json:{exists:true,result:'crm_reused',lead_id:ctx.lead.id,created:ctx.created,route:ctx.route,approval_status:rows[0].approval_status,follow_up_status:rows[0].follow_up_status}}];\nconst l=ctx.lead;\nconst crm={lead_id:l.id,created_at:l.created_at,name:l.name,email:l.email,company:l.company??'',source:l.source,service_interest:l.service_interest??'',budget_range:l.budget_range??'',timeline:l.timeline??'',company_size:l.company_size??'',lead_score:l.lead_score,qualification:l.qualification,final_qualification:ctx.route,final_priority:l.final_priority??l.priority,final_recommended_action:l.final_recommended_action??l.recommended_action,ai_status:l.ai_status??'',ai_summary:l.ai_assessment?.summary??'',approval_status:ctx.route==='cold'?'not_required':'pending',approval_decision:'',approved_at:'',follow_up_status:ctx.route==='cold'?'nurture':'awaiting_approval',follow_up_sent_at:'',last_action_at:new Date().toISOString(),notes:''};\nreturn [{json:{exists:false,crm,created:ctx.created,route:ctx.route}}];"
      },
