        "path": "ph03-lead-approval",
        "formTitle": "Lead follow-up approval",
        "formDescription": "Authorized reviewers only. Approve or reject a stored lead follow-up.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "lead_id",
              "fieldName": "lead_id",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "decision",
              "fieldName": "decision",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "approve"
                  },
                  {
                    "option": "reject"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "notes",
              "fieldName": "notes",
              "fieldType": "textarea"
            }
          ]
        },
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Approval Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "template-approval-form",
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data=$input.first().json;\nconst lead_id=typeof data.lead_id==='string'?data.lead_id.trim():'';\nconst decision=typeof data.decision==='string'?data.decision.trim():'';\nconst notes=typeof data.notes==='string'?data.notes.trim():'';\nconst valid=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(lead_id) && ['approve','reject'].includes(decision) && notes.length<=1000;\nreturn [{json:{valid,lead_id,decision,notes,result:valid?'validated':'invalid_approval'}}];"
      },
      "name": "Validate Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "id": "template-validate-decision",
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $json.valid ? 'yes' : 'no' }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Valid Decision",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
