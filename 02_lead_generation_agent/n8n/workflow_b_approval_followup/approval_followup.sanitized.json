      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const request=$('Validate Decision').first().json;\nconst lead=$('Fetch Stored Lead').first().json;\nconst rows=$input.all().map(i=>i.json).filter(r=>r.lead_id!==undefined && String(r.lead_id).trim()!=='');\nconst stop=result=>[{json:{action:'stop',result}}];\nif (!lead || lead.id!==request.lead_id) return stop('lead_mismatch');\nif (rows.length!==1 || rows[0].lead_id!==lead.id) return stop('crm_missing_or_conflicting');\nconst crm=rows[0];\nconst status=String(crm.follow_up_status??'').trim().toLowerCase();\nif (status==='sent' || crm.follow_up_sent_at) return stop('already_sent');\nif (status==='sending') return stop('manual_reconciliation_required');\nconst route=lead.final_qualification??lead.qualification;\nif (!['warm','hot'].includes(route)) return stop('ineligible_qualification');\nif (!['awaiting_approval','not_sent'].includes(status)) return stop('invalid_crm_state');\nif (!['approve','reject'].includes(request.decision)) return stop('invalid_approval');\nif (request.decision==='approve' && (typeof lead.email!=='string' || !/^[^\\s@,;<>]+@[^\\s@,;<>]+\\.[^\\s@,;<>]+$/.test(lead.email))) return stop('invalid_recipient');\nreturn [{json:{action:request.decision==='approve'?'send':'reject',result:'eligible',lead,route,notes:request.notes}}];"
      },
