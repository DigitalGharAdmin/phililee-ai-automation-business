    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx=$input.first().json;\nif (ctx.action!=='send' || !['hot','warm'].includes(ctx.route)) throw new Error('Follow-up not eligible.');\nconst services={ai_customer_support:'AI customer support',lead_generation:'lead generation',email_automation:'email automation',n8n_automation:'workflow automation',rag_knowledge_bot:'a knowledge assistant',reporting_dashboard:'a reporting dashboard',custom_ai_automation:'custom AI automation',other:'your requested service'};\nconst service=services[ctx.lead.service_interest]??'your requested service';\nconst clean=v=>String(v??'').replace(/[\\r\\n\\t]/g,' ').trim();\nconst name=clean(ctx.lead.name)||'there';\nconst company=clean(ctx.lead.company);\nconst subject=`Regarding your ${service} inquiry - Phililee AI Labs`;\nconst invitation=ctx.route==='hot'?'Would you like to arrange a short discovery call to discuss next steps?':'Would more information or a short discussion be helpful?';\nconst email_body=`Hello ${name},\\n\\nThank you for your interest in ${service}${company?' for '+company:''}. ${invitation}\\n\\nBest regards,\\nPhililee AI Labs`;\nconst crm={lead_id:ctx.lead.id,approval_status:'approved',approval_decision:'approve',approved_at:new Date().toISOString(),follow_up_status:'sending',follow_up_sent_at:'',last_action_at:new Date().toISOString(),notes:ctx.notes};\nreturn [{json:{crm,recipient:ctx.lead.email,subject,email_body}}];"
      },
