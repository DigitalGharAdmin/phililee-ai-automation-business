        "responses": {
          "values": [
            {
              "content": "=You are an AI email classification assistant for a business automation system.\n\nAnalyze the incoming email and classify it.\n\nEMAIL DATA:\nFrom: {{ $json.From }}\nSubject: {{ $json.Subject }}\nMessage: {{ $json.snippet  }}\n\nReturn ONLY valid JSON in exactly this structure:\n\n{\n  \"category\": \"support\",\n  \"priority\": \"medium\",\n  \"summary\": \"Short summary of the email\",\n  \"status\": \"classified\"\n}\n\nCATEGORY RULES:\nChoose exactly one:\n- support\n- sales\n- order\n- billing\n- complaint\n- spam\n- general\n\nPRIORITY RULES:\nChoose exactly one:\n- low\n- medium\n- high\n\nUse the sender, subject, and message content to determine the best category and priority.\nKeep the summary concise.\nDo not include markdown, code fences, explanations, or any text outside the JSON object."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        224,
        0
      ],
      "id": "440310f8-a40a-4662-9461-075920bc2f1f",
      "name": "Message a model"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item) => {\n  const text = item.json.output?.[0]?.content?.[0]?.text;\n\n  if (!text) {\n    throw new Error('OpenAI classification output text is missing.');\n  }\n\n  let classification;\n\n  try {\n    classification = JSON.parse(text);\n  } catch (error) {\n    throw new Error(`Invalid JSON returned by OpenAI: ${text}`);\n  }\n\n  return {\n    json: {\n      category: classification.category,\n      priority: classification.priority,\n      summary: classification.summary,\n      status: classification.status,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
