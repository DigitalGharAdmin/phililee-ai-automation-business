OPENAI_API_KEY=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
APP_ENV=development
ENABLE_DEBUG_ENDPOINTS=true
# Store only a 64-character SHA-256 digest here; keep the raw key in n8n.
N8N_SERVICE_KEY_SHA256=
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CHECK_REVOKED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60
# Production must use external; the in-process limiter remains defense in depth.
RATE_LIMIT_BACKEND=memory
# Required with RATE_LIMIT_BACKEND=external; supply through the platform secret store.
RATE_LIMIT_REDIS_URL=
ENABLE_API_DOCS=true
# Enable only when production is served exclusively over HTTPS.
ENABLE_HSTS=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
